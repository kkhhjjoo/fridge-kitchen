# ────────────────────────────────────────────────────────────
#  이 파일을 복사해서 .env.local 을 만들고 값을 채우세요.
#  (.env.local 은 .gitignore 에 포함되어 git에 올라가지 않습니다)
#
#  값 위치: Supabase 대시보드 → Project Settings → API Keys
#  - URL: https://<project-ref>.supabase.co
#  - KEY: Publishable key (sb_publishable_...) 또는 예전 이름인 anon public key
#
#  ⚠️ service_role / secret 키는 절대 넣지 마세요. 브라우저에 노출되면 모든 데이터가 위험해집니다.
#  두 값이 비어 있으면 앱은 "데모 모드"(브라우저 localStorage에 저장)로 동작합니다.
# ────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://kthfuhwzhyecvwdhcbqd.supabase.co/rest/v1/
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_qbogUI6OfYYYlxzHKS4_mA_jenDMzgS
